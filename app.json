{
  "expo": {
    "name": "prefai",
    "slug": "prefai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prefai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record voice for translation.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert voice to text for translation."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.prefai"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./withJetifier",
      "expo-localization",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "This app uses the microphone to translate your speech.",
          "speechRecognitionPermission": "This app uses speech recognition to translate your speech."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save PDFs to your device",
          "savePhotosPermission": "Allow access to save PDFs to your device"
        }
      ],
      "expo-web-browser",
         [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "193989f8-3ac9-4d67-a12f-946c4e311ecf"
      }
    },
    "owner": "kartik_01a"
  }
}
