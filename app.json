{
  "expo": {
    "name": "prefai",
    "slug": "prefai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prefai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "permissions": ["RECORD_AUDIO"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record voice for translation.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert voice to text for translation."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "package": "com.anonymous.prefai"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "This app uses the microphone to translate your speech.",
          "speechRecognitionPermission": "This app uses speech recognition to translate your speech."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow this app to access your microphone for voice translation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save PDFs to your device",
          "savePhotosPermission": "Allow access to save PDFs to your device"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-facebook"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "193989f8-3ac9-4d67-a12f-946c4e311ecf"
      }
    },
    "owner": "kartik_01a"
  }
}
